{% extends "common/layout.njk" %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  <a class="govuk-back-link" href="/admin/search-index">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-content">
      <h1 class="govuk-heading-l">Are you sure you want to delete the search index?</h1>

      {{ govukWarningText({
        text: "Search will show no results until you rebuild the index.",
        iconFallbackText: "Warning"
      }) }}

      <form method="post">
        {{ govukButton({
          text: "Yes, delete the search index",
          classes: "govuk-button--warning",
          preventDoubleClick: true
        }) }}
      </form>

      <p class="govuk-body">
        <a class="govuk-link" href="/admin/search-index">Cancel</a>
      </p>
    </div>
  </div>
{% endblock %}
