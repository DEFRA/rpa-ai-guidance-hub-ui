{% extends "common/layout.njk" %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageTitle = 'Home' %}
{% set page = 'home' %}

{% block content %}
  <div class="defra-hero">
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <p class="govuk-caption-xl">Rural Payments Agency</p>
          <h1 class="govuk-heading-xl">AI Guidance Hub</h1>

          <p class="govuk-body-l">
            Find, review and manage RPA guidance documents, all in one place. 
          </p>

          <a href="/login/callback" class="govuk-button govuk-button--start defra-hero__button">
            Sign in
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
            </svg>
          </a>

          <p class="govuk-body">
            This is an internal service. You need a Defra account to sign in.
          </p>
        </div>

        <div class="govuk-grid-column-one-third">
          <aside class="defra-hero__whats-new">
            <h2 class="govuk-heading-s">What you can do in the hub</h2>
            <ul class="govuk-list govuk-list--bullet">
              <li>search all RPA guidance by document name, scheme or topic</li>
              <li>check whether a document is up to date</li>
              <li>pick up drafts you are working on</li>
              <li>review and approve documents sent to you</li>
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-width-container govuk-!-margin-top-6">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">If you cannot sign in</h2>

        <p class="govuk-body">
          Email the AI Capability and Enablement team at
          <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk">AICapabilityAndEnablement@defra.gov.uk</a>.
        </p>
      </div>
    </div>
  </div>
{% endblock %}
