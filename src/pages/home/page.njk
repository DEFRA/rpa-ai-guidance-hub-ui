{% extends "common/layout.njk" %}

{% set pageTitle = 'Home' %}
{% set page = 'home' %}
{# Lines the header's logo up with the hero's content (_app-sign-in-hero.scss). #}
{% set bodyClasses = 'app-sign-in-page' %}

{% block content %}
  {#
    The sign-in page, as the design (the prototype's sign-in page) has it: a
    full-width green hero with a white start button, and a panel of what the
    hub does beside it.
  #}
  <div class="app-sign-in-hero">
    <div class="app-sign-in-hero__inner">
      <div class="app-sign-in-hero__content">
        <p class="app-sign-in-hero__caption">Rural Payments Agency</p>
        <h1 class="govuk-heading-xl app-sign-in-hero__title">Guidance hub</h1>

        <p class="govuk-body-l app-sign-in-hero__description">
          Find, review and manage RPA guidance documents, all in one place.
        </p>

        <a href="/login/callback" class="govuk-button govuk-button--start app-sign-in-hero__start-button" role="button" draggable="false" data-module="govuk-button">
          Sign in
          <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
          </svg>
        </a>

        <p class="govuk-body app-sign-in-hero__note">
          This is an internal service. You need a Defra account to sign in.
        </p>
      </div>

      <div class="app-sign-in-hero__panel">
        <h2 class="govuk-heading-m">What you can do in the hub</h2>
        <ul class="govuk-list govuk-list--bullet">
          <li>search all RPA guidance by document name, scheme or topic</li>
          <li>check whether a document is up to date</li>
          <li>pick up drafts you are working on</li>
          <li>review and approve documents sent to you</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="app-sign-in-section govuk-!-margin-top-6">
    <div class="app-sign-in-hero__inner">
      <div class="app-sign-in-hero__content">
        <h2 class="govuk-heading-m">If you cannot sign in</h2>

        <p class="govuk-body">
          Email the AI Capability and Enablement team at
          <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk">AICapabilityAndEnablement@defra.gov.uk</a>.
        </p>
      </div>
    </div>
  </div>
{% endblock %}
