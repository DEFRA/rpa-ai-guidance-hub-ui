{% extends "common/layout.njk" %}

{# For a user who can use the hub but lacks a role this page needs: the side
   navigation stays, so the content sits in the usual width container rather
   than the full-width `app-error-page` of the pages shown without it. #}
{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You do not have permission to do this</h1>

        <p class="govuk-body">
          You need the <strong>{{ missingRoles }}</strong> {{ "role" if missingRoles.indexOf(" and ") == -1 else "roles" }} to {{ reason }}.
        </p>

        <div class="govuk-inset-text app-error-page__inset">
          If you think you should have access, email the AI Capability and Enablement team at
          <a class="govuk-link" href="mailto:{{ accessRequestEmail }}">{{ accessRequestEmail }}</a>.
        </div>

        <p class="govuk-body">
          If you have just been given the role, <a class="govuk-link" href="/logout">sign out</a> and sign in again.
        </p>
      </div>
    </div>
  </div>
{% endblock %}
