{% extends "common/layout.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "common/guidance-table.njk" import guidanceTablePanel %}
{% from "common/guide-list.njk" import guideList %}

{% set pageTitle = 'RPA Guidance Hub' %}
{% set page = 'hub' %}
{# The hub has its own search box, so the side navigation leaves out its own. #}
{% set hideNavSearch = true %}

{% block content %}
  <div class="defra-hero defra-hero--hub govuk-!-margin-bottom-6">
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l govuk-!-margin-bottom-4">RPA Guidance hub</h1>

          {# The words are kept in the address (q), and by the filters below. #}
          <form class="defra-hero__search" action="/hub" method="get" role="search">
            <label class="govuk-visually-hidden" for="hub-search">Search or ask question</label>
            <div class="defra-search-bar">
              <input class="govuk-input defra-search-bar__input" id="hub-search" name="q" type="search" autocomplete="off" placeholder="Search or ask a question about all guidance" value="{{ words }}">
              <button class="defra-search-bar__button defra-search-bar__button--on-green" type="submit">
                <span class="govuk-visually-hidden">Search</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 27 27" aria-hidden="true" focusable="false"><circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3" fill="none"></circle><line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line></svg>
              </button>
            </div>
          </form>

          <p class="govuk-body govuk-!-margin-top-4 govuk-!-margin-bottom-0">
            Find guidance to help you review and process claims, or manage guidance documents if you're responsible for keeping them up to date.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        {% if filters %}
          {# The filters beside the list, as the prototype's hub has them. #}
          <div class="app-hub-columns">
            {% include "hub/partials/filters.njk" %}

            <div class="app-hub-results" id="guide-results">
              {% call guideList(shown) %}
                {% if filters.sort %}{% include "hub/partials/sort.njk" %}{% endif %}
              {% endcall %}
            </div>
          </div>
        {% else %}
          {{ guidanceTablePanel(shown) }}
        {% endif %}
      </div>
    </div>

  </div>
{% endblock %}
