{% extends "common/layout.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "common/guidance-table.njk" import guidanceTablePanel %}
{% from "common/tab-label.njk" import tabLabel %}

{% set pageTitle = 'RPA Guidance Hub' %}
{% set page = 'hub' %}
{% set showNav = false %}

{% block content %}
  <div class="defra-hero defra-hero--hub govuk-!-margin-bottom-6">
    <div class="govuk-width-container">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l govuk-!-margin-bottom-4">RPA Guidance hub</h1>

          <p class="govuk-body govuk-!-margin-bottom-0">
            Find guidance to help you review and process claims, or manage guidance documents if you're responsible for keeping them up to date.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <form action="/hub" method="get" role="search">
          <div class="app-search-form__group">
            {{ govukInput({
              id: "search",
              name: "search",
              type: "search",
              label: {
                text: "Search guidance",
                classes: "govuk-label--m"
              },
              formGroup: {
                classes: "govuk-!-margin-right-3"
              }
            }) }}

            {{ govukButton({
              text: "Search"
            }) }}
          </div>
        </form>

      </div>
    </div>

    {# A designer's functions, kept together so an operator's view can leave them out. #}
    {% if isDesigner %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
          <h2 class="govuk-heading-l" id="designing">Designing</h2>
          <div class="govuk-button-group">
            <a class="govuk-button" href="/create-guidance/upload-guide">Upload guidance</a>
          </div>
          {{ guidanceTablePanel(awaitingMyReview) }}
        </div>
      </div>
    {% endif %}

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        {% set recentlyOpenedPanelHtml %}{{ guidanceTablePanel(recentlyOpened) }}{% endset %}
        {% set pinnedPanelHtml %}{{ guidanceTablePanel(pinned) }}{% endset %}
        {% set bookmarkedGuidesPanelHtml %}{{ guidanceTablePanel(bookmarkedGuides) }}{% endset %}
        {% set allGuidesPanelHtml %}{{ guidanceTablePanel(allGuides) }}{% endset %}

        {{ govukTabs({
          title: "Contents",
          items: [
            {
              label: tabLabel(allGuides.heading, allGuides.count),
              id: "all-guides",
              panel: {
                html: allGuidesPanelHtml
              }
            },
            {
              label: tabLabel(recentlyOpened.heading, recentlyOpened.count),
              id: "recently-opened",
              panel: {
                html: recentlyOpenedPanelHtml
              }
            },
            {
              label: tabLabel(pinned.heading, pinned.count),
              id: "pinned",
              panel: {
                html: pinnedPanelHtml
              }
            },
            {
              label: tabLabel(bookmarkedGuides.heading, bookmarkedGuides.count),
              id: "bookmarked-guides",
              panel: {
                html: bookmarkedGuidesPanelHtml
              }
            }
          ]
        }) }}
      </div>
    </div>

  </div>
{% endblock %}
