{% extends "common/layout.njk" %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = 'RPA Guidance Hub' %}
{% set page = 'hub' %}

{% macro guidanceTablePanel(table, type) %}
  {% if table.isEmpty %}
    {% if type == 'all' and search is defined and search != '' %}
      <p class="govuk-body">No guidance found for your search.</p>
    {% elif type == 'all' %}
      <p class="govuk-body">No guidance has been published yet.</p>
    {% elif type == 'recent' %}
      <p class="govuk-body">You haven't opened any guidance yet. Any guidance you open will appear here.</p>
    {% elif type == 'saved' %}
      <p class="govuk-body">You haven't saved any guidance yet. Select 'Save' on a guide to add it here.</p>
    {% endif %}
  {% else %}
    {{ govukTable({ head: table.head, rows: table.rows }) }}
  {% endif %}
{% endmacro %}

{% macro tabLabel(text, count) %}
  {%- if count and count > 0 -%}
    {{ text }} ({{ count }})
  {%- else -%}
    {{ text }}
  {%- endif -%}
{% endmacro %}

{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-l">Find and manage guidance</h2>

        <p class="govuk-body">
          Search for guidance, or browse everything that's published. Guidance owners and editors can also manage guidance from this page.
        </p>

        <form action="/hub" method="get" role="search">
          <div class="app-search-form__group">
            {{ govukInput({
              id: "search",
              name: "search",
              type: "search",
              label: {
                text: "Search guidance",
                classes: "govuk-label--m"
              },
              formGroup: {
                classes: "govuk-!-margin-right-3"
              }
            }) }}

            {{ govukButton({
              text: "Search"
            }) }}
          </div>
        </form>

        <h3 class="govuk-heading-m">Manage guidance</h3>

        <div class="govuk-button-group">
          <a class="govuk-button" href="/create-guidance/upload-guide">Migrate guidance</a>
        </div>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        {{ govukTabs({
          items: [
            {
              label: tabLabel("All guidance", allGuidance.count),
              id: "all-guidance",
              panel: { html: guidanceTablePanel(allGuidance, 'all') }
            },
            {
              label: tabLabel("Recently opened", recentlyOpened.count),
              id: "recently-opened",
              panel: { html: guidanceTablePanel(recentlyOpened, 'recent') }
            },
            {
              label: tabLabel("Saved guidance", savedGuidance.count),
              id: "saved-guidance",
              panel: { html: guidanceTablePanel(savedGuidance, 'saved') }
            }
          ]
        }) }}
      </div>
    </div>
  </div>
{% endblock %}
