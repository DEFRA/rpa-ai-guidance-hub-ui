{#
  Text in parts, the words searched for marked; the plain text when it has
  no parts.
#}
{% macro marked(parts, text) -%}
  {%- if parts -%}
    {%- for part in parts -%}
      {%- if part.match -%}<mark class="app-search-match">{{ part.text }}</mark>{%- else -%}{{ part.text }}{%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {{ text }}
  {%- endif -%}
{%- endmacro %}
