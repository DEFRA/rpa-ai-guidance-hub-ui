{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{#
  The filter panel beside a list of guides, as the prototype's hub has it:
  one GET form, so it works without JavaScript; each filter a group that
  opens like a folder, open when something in it is chosen; each option with
  its count. The chosen values are tags in the toolbar above. Reads `filters`
  (hub/filters.js's filterPanel).
#}
<aside class="app-hub-filters" id="hub-filters-panel" aria-labelledby="hub-filters-heading">
  <div class="app-hub-filters__header">
    <h2 class="govuk-heading-s app-hub-filters__title" id="hub-filters-heading">Narrow down the list</h2>
    <p class="govuk-body-s app-hub-filters__hint">Like opening a folder. Pick one or more.</p>
  </div>

  <form id="hub-filters" method="get" action="{{ filters.action }}#guide-results">
    {# The list's own parameters: the words searched for, or the case it is narrowed to. #}
    {% for name, value in filters.kept %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
    {% for group in filters.groups %}
      {% set items = [] %}
      {% for option in group.options %}
        {% set optionHtml %}{{ option.text }} <span class="app-hub-filters__count">({{ option.count }})</span>{% endset %}
        {% set _ = items.push({ name: option.name, value: option.value, html: optionHtml, checked: option.checked, disabled: option.disabled }) %}
      {% endfor %}

      <details class="app-hub-filters__group"{% if group.selectedCount %} open{% endif %}>
        <summary class="app-hub-filters__summary">
          <span class="app-hub-filters__summary-text">{{ group.legend }}</span>
          {% if group.selectedCount %}<span class="app-hub-filters__selected-count">&middot; {{ group.selectedCount }} selected</span>{% endif %}
        </summary>
        {{ govukCheckboxes({
          idPrefix: group.name,
          name: group.name,
          classes: "govuk-checkboxes--small",
          formGroup: { classes: "app-hub-filters__options" },
          fieldset: { legend: { text: group.legend, classes: "govuk-visually-hidden" } },
          items: items
        }) }}
      </details>
    {% endfor %}

    <div class="app-hub-filters__actions">
      {{ govukButton({
        text: "Apply",
        classes: "govuk-!-margin-bottom-0"
      }) }}
      {% if filters.selected.length %}
        <a class="govuk-link app-hub-filters__clear" href="{{ filters.clearHref }}">Clear filters</a>
      {% endif %}
    </div>
  </form>
</aside>
