{% extends "common/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ govukBackLink({ href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-content">

      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">Check the details before you convert</h1>

      {% include "create-guidance/common/guide-summary-cards.njk" %}

      <p class="govuk-body">
        When you convert this document, it is saved as a draft that only you
        can see until it is reviewed and published.
      </p>

      <form method="post">
        <span id="conversion-error"></span>
        {{ govukButton({ text: "Convert document" }) }}
      </form>

      {% include "create-guidance/common/start-over-link.njk" %}
    </div>
  </div>
{% endblock %}
