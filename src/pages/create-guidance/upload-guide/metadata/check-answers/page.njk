{% extends "common/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  {{ govukBackLink({ href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-content">

      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">Check the details before you convert</h1>

      {{ govukSummaryList({ card: guideDetailsCard, rows: guideDetailsCard.rows }) }}
      {{ govukSummaryList({ card: ownerPurposeCard, rows: ownerPurposeCard.rows }) }}

      <p class="govuk-body">
        When you convert this document, it is saved as a draft that only you
        can see until it is reviewed and published.
      </p>

      <p class="govuk-body">
        The ability to convert guides has not been implemented yet.
        <a class="govuk-link" href="{{ hubUrl }}">Return to hub</a>
      </p>
    </div>
  </div>
{% endblock %}
