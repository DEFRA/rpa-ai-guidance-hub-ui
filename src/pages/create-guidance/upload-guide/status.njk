{% extends "common/layout.njk" %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block head %}
  {{ super() }}
  {% if refreshInterval %}
    <noscript>
      <meta http-equiv="refresh" content="{{ refreshInterval }}">
    </noscript>
    <meta http-equiv="refresh" content="{{ refreshInterval }}" id="meta-refresh">
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-content">
      {% if isError and errorList and errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <span class="govuk-caption-l">{{ caption }}</span>
      <h1 class="govuk-heading-l" id="upload-status-heading">{{ pageHeading }}</h1>

      {% if isError %}
        <p class="govuk-body" id="upload-status-error">
          {{ errorMessage }}
        </p>

        <p class="govuk-body">
          You can try uploading the document again, or select a different file.
        </p>

        {{ govukButton({
          text: "Upload another document",
          href: retryUrl
        }) }}
      {% else %}
        <div
          id="upload-status-container"
          class="app-upload-status"
          data-poll-url="{{ pollUrl }}"
          data-redirect-url="{{ redirectUrl }}"
          data-upload-id="{{ uploadId }}"
          data-is-ready="{{ isReady }}"
          data-is-error="{{ isError }}"
        >
          <div
            class="app-progress-bar"
            id="upload-progress-bar"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="{{ progressPercentage }}"
            aria-labelledby="upload-status-heading"
          >
            <div class="app-progress-bar__inner" style="width: {{ progressPercentage }}%;"></div>
          </div>

          <p class="govuk-body govuk-!-margin-top-4" id="upload-status-message" aria-live="polite">
            {{ statusMessage }}
          </p>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
