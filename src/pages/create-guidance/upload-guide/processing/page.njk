{% extends "common/layout.njk" %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block head %}
  {{ super() }}
  <style nonce="{{ cspNonce.style }}">
    #upload-progress-bar {
      width: {{ percentage }}%
    }
  </style>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-content">
      <div data-module="app-progress"
        data-poll-url="{{ pollUrl }}"
        data-redirect-url="{{ redirectUrl }}">

        <div data-progress-error{% if not isError %} hidden{% endif %}>
          {% set errorSummaryHtml %}
            <span data-progress-error-message>{{ errorMessage }}</span><br>
            <span data-progress-error-detail{% if not errorDetail %} hidden{% endif %}>{{ errorDetail }}</span>
          {% endset %}

          {{ govukErrorSummary({
            titleText: "There is a problem",
            descriptionHtml: errorSummaryHtml
          }) }}
        </div>

        <h1 class="govuk-heading-l" id="upload-status-heading">Document upload</h1>

        <p class="govuk-body" data-progress-intro{% if isError %} hidden{% endif %}>We scan every file for viruses before it goes into the hub. This usually takes a few seconds.</p>

        <noscript>
          {{ govukWarningText({
            text: "JavaScript is required for this page to automatically refresh. Refresh manually to see updates.",
            iconFallbackText: "Warning"
          }) }}
        </noscript>

        <div class="app-progress{{ ' app-progress--error' if isError }}">
          <p class="app-progress__status" id="upload-status-label" data-progress-label role="status">{{ label }}</p>
          <div class="app-progress__track" role="progressbar" aria-labelledby="upload-status-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percentage }}">
            <div id="upload-progress-bar" class="app-progress__bar{{ ' app-progress__bar--error' if isError }}" data-progress-bar data-percentage="{{ percentage }}"></div>
          </div>
        </div>

        <p class="govuk-body" data-progress-waiting{% if isError %} hidden{% endif %}>Do not close this page.</p>

        <div data-progress-retry{% if not isError %} hidden{% endif %}>
          {% include "create-guidance/common/start-over-link.njk" %}
        </div>

        <p class="govuk-body" data-progress-complete hidden>
          Your file has been checked. <a class="govuk-link" href="{{ redirectUrl }}">Continue to the guide's details</a>.
        </p>

        <p class="govuk-body" data-progress-timeout hidden>
          This is taking longer than expected. <a class="govuk-link" href="{{ processingUrl }}">Refresh the page</a> to check again.
        </p>
      </div>
    </div>
  </div>
{% endblock %}
