{% extends "govuk/template.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% if mainClasses is not defined %}
  {% set mainClasses = "app-main-wrapper" %}
{% endif %}

{% block head %}
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{% block header %}
  {# Signed in, the side navigation takes the header's place. #}
  {% if not isAuthenticated %}
  <header class="defra-header" role="banner">
    <div class="defra-header__inner">
    <div class="defra-header__brand-group">
      <img
        src="{{ getAssetPath('src/client/images/defra-logo.svg') }}"
        alt="Department for Environment, Food &amp; Rural Affairs"
        class="defra-header__logo"
      />
      {# Only the logo: the sign-in page names the service and offers sign-in. #}
    </div>
    </div>
  </header>
  {% endif %}
{% endblock %}

{# Signed in, every page has the side navigation beside its content. #}
{% block container %}
  {% if isAuthenticated %}
    {# Folds the side navigation away or opens it out, then comes back here. #}
    <form id="side-nav-toggle-form" method="post" action="/side-nav/toggle" hidden>
      <input type="hidden" name="collapsed" value="{{ 'false' if sideNavCollapsed else 'true' }}">
      <input type="hidden" name="returnTo" value="{{ currentUrl }}">
    </form>
    <div class="app-layout{% if sideNavCollapsed %} app-layout--collapsed{% endif %}">
      <div class="app-layout__nav">
        {% include "common/side-nav.njk" %}
      </div>
      <div class="app-layout__main">{{ super() }}</div>
    </div>
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle if pageTitle else serviceName }} | {{ serviceName }}
{% endblock %}

{% block beforeContent %}
  {% if breadcrumbs %}
    <div class="govuk-width-container govuk-!-margin-bottom-3">
      {{ govukBreadcrumbs({ items: breadcrumbs }) }}
    </div>
  {% endif %}
{% endblock %}

{% block content %}
{% endblock %}

{% block footer %}
  <footer class="defra-footer" role="contentinfo">
    <div class="govuk-width-container{% if containerClasses %} {{ containerClasses }}{% endif %}">
      {% if aceSlackChannel %}
        <p class="govuk-body-s govuk-!-margin-top-3 govuk-!-margin-bottom-0">
          Questions? Contact the AICE team on Slack <a class="defra-footer__link" href="{{ aceSlackChannel }}">#ask-ace</a>
        </p>
      {% endif %}
    </div>
  </footer>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
