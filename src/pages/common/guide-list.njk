{% from "govuk/components/tag/macro.njk" import govukTag %}

{#
  A list of guides as the prototype's hub shows them (its
  playground/hub/page.njk result rows): each guide's version and Live tags,
  its title as a link, its purpose, and when it was last updated and
  published. Without the prototype's pin star and "Pinned" tag, which come
  with pins.

  Reads a HubViewModel list: {heading, showing, emptyMessage, isEmpty, guides}:
  its heading is how many guides it has, and under it which it shows. Called
  with a block, it puts what the block gives under those (the sort).
#}
{% macro guideList(list) %}
  <div class="app-hub-results__header">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-1">{{ list.heading }}</h2>
    {% if list.showing %}
      <p class="govuk-body govuk-!-margin-bottom-1 app-hub-results__showing">{{ list.showing }}</p>
    {% endif %}
    {% if caller %}{{ caller() }}{% endif %}
  </div>
  {% if list.isEmpty %}
    <p class="govuk-body">{{ list.emptyMessage }}</p>
  {% else %}
    <ul class="app-search-results">
      {% for guide in list.guides %}
        <li class="app-search-results__item">
          <div class="app-search-results__top app-hub-results__top">
            <div class="govuk-!-margin-bottom-2">
              {% if guide.versionTag %}
                {{ govukTag({ text: guide.versionTag.text, classes: "govuk-tag--" + guide.versionTag.colour }) }}
              {% endif %}
              {{ govukTag({ text: "Live", classes: "govuk-tag--turquoise" }) }}
            </div>
          </div>

          <h3 class="govuk-heading-s app-search-results__name">
            <a class="govuk-link" href="{{ guide.href }}">{{ guide.title }}</a>
          </h3>

          {% if guide.purpose %}
            <p class="govuk-body-s app-hub-results__facets">{{ guide.purpose }}</p>
          {% endif %}

          <p class="govuk-body-s app-search-results__dates">Last updated: {{ guide.lastUpdated }} &middot; Published: {{ guide.published }}</p>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
