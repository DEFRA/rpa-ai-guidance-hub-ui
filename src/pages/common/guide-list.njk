{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "common/icon.njk" import icon %}

{#
  A list of guides as the prototype's hub shows them (its
  playground/hub/page.njk result rows): each guide's version and Live tags,
  its title as a link, its purpose, and when it was last updated and
  published; and, where the user's pins are known, its star, which pins or
  unpins it (a form, so it works without JavaScript), and a "Pinned" tag.

  Reads a HubViewModel list: {heading, showing, emptyHtml, isEmpty, guides}:
  its heading is how many guides it has, and under it which it shows; and the
  page's address, which a star sends the user back to (a macro does not see
  the page's own). Called with a block, it puts what the block gives under
  those (the sort).
#}
{% macro guideList(list, returnTo) %}
  <div class="app-hub-results__header">
    <h2 class="govuk-heading-l govuk-!-margin-bottom-1">{{ list.heading }}</h2>
    {% if list.showing %}
      <p class="govuk-body govuk-!-margin-bottom-1 app-hub-results__showing">{{ list.showing }}</p>
    {% endif %}
    {% if caller %}{{ caller() }}{% endif %}
  </div>
  {% if list.isEmpty %}
    <p class="govuk-body">{{ list.emptyHtml | safe }}</p>
  {% else %}
    <ul class="app-search-results">
      {% for guide in list.guides %}
        <li class="app-search-results__item{% if guide.pin.pinned %} app-search-results__item--pinned{% endif %}">
          <div class="app-search-results__top app-hub-results__top">
            <div class="govuk-!-margin-bottom-2">
              {% if guide.versionTag %}
                {{ govukTag({ text: guide.versionTag.text, classes: "govuk-tag--" + guide.versionTag.colour }) }}
              {% endif %}
              {{ govukTag({ text: "Live", classes: "govuk-tag--turquoise" }) }}
              {% if guide.pin.pinned %}<strong class="govuk-tag govuk-tag--grey app-search-results__pinned-tag">Pinned</strong>{% endif %}
            </div>
            {% if guide.pin %}
              {# A pinned section's star is named for the section, so it is not
                 taken for its guide's, on the page or after unpinning. #}
              {% set pinId = "pin-" + (guide.pin.sectionId or guide.id) %}
              {# Unpinning takes a row out of a list of only pins, so its star
                 comes back to the list, not to a row no longer there. #}
              {% set backTo = "guide-results" if list.onlyPins else pinId %}
              <form class="app-pin-toggle" method="post" action="/pin-toggle"{% if guide.pin.pinned %} data-reorder-follows="{{ guide.pin.key }}"{% endif %}>
                <input type="hidden" name="guideId" value="{{ guide.id }}">
                <input type="hidden" name="pin" value="{{ 'false' if guide.pin.pinned else 'true' }}">
                {% if guide.pin.pinned %}<input type="hidden" name="position" value="{{ guide.pin.position }}">{% endif %}
                {% if guide.pin.sectionId %}<input type="hidden" name="sectionId" value="{{ guide.pin.sectionId }}">{% endif %}
                <input type="hidden" name="returnTo" value="{{ returnTo }}">
                <input type="hidden" name="anchor" value="{{ backTo }}">
                <button type="submit" class="app-pin-toggle__button" id="{{ pinId }}" aria-pressed="{{ 'true' if guide.pin.pinned else 'false' }}">
                  {{ icon("star-filled" if guide.pin.pinned else "star") }}
                  <span class="govuk-visually-hidden">Pin {{ guide.title }}</span>
                </button>
              </form>
            {% endif %}
          </div>

          <h3 class="govuk-heading-s app-search-results__name">
            <a class="govuk-link" href="{{ guide.href }}">{{ guide.title }}</a>
          </h3>

          {% if guide.guideTitle %}
            <p class="govuk-body-s app-hub-results__facets">In {{ guide.guideTitle }}</p>
          {% endif %}

          {% if guide.purpose %}
            <p class="govuk-body-s app-hub-results__facets">{{ guide.purpose }}</p>
          {% endif %}

          <p class="govuk-body-s app-search-results__dates">Last updated: {{ guide.lastUpdated }} &middot; Published: {{ guide.published }}</p>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
