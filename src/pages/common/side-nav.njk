{#
  The side navigation, on every page once signed in (common/layout.njk), in
  place of the header. Its look and behaviour follow the prototype's side
  navigation (rpa-ai-guidance-hub-prototype: app/views/partials/side-nav.njk).

  Each list has a page of its own on the hub (/hub/pinned), so the server
  marks the current item.
  Folded away (sideNavCollapsed), it is a strip of icons instead, each with its
  name for a screen reader and as a tooltip; both fold and unfold through the
  layout's #side-nav-toggle-form.
#}
{% from "common/icon.njk" import icon %}

{% set onUpload = currentPath and currentPath.indexOf('/create-guidance') == 0 %}
{# The hub and its lists keep the filters chosen (listQuery), so moving between
   them keeps the same guides in view. #}
{% set listItems = [
  { text: "Hub", href: "/hub" + listQuery, icon: "home", current: currentPath == "/hub" },
  { text: "Recently opened", href: "/hub/recently-opened" + listQuery, icon: "clock", current: currentPath == "/hub/recently-opened" },
  { text: "Pinned", href: "/hub/pinned" + listQuery, icon: "star", current: currentPath == "/hub/pinned", badge: pinnedCount, badgeUnit: "pins" },
  { text: "Bookmarked", href: "/hub/bookmarked-guides" + listQuery, icon: "bookmark", current: currentPath == "/hub/bookmarked-guides", ariaCurrent: "true" if currentCaseKey else "page", badge: caseCount, badgeUnit: "cases" }
] %}
{% set editorItems = [
  { text: "Upload guidance", href: "/create-guidance/upload-guide", icon: "upload", current: onUpload }
] %}

{# On a case's own list, "Bookmarked" is the list it belongs to
   (aria-current="true") and the case's link is the page (ariaCurrent
   defaults to "page"). #}
{# A list's count, as on the open navigation, is a dot on its icon, and part
   of its name for a screen reader, as the prototype's rail has it. #}
{% macro railItem(text, iconName, href, current, badge, badgeUnit, ariaCurrent) %}
  <a class="app-side-nav__rail-item{% if current %} app-side-nav__rail-item--current{% endif %}" href="{{ href }}"{% if current %} aria-current="{{ ariaCurrent or 'page' }}"{% endif %} data-side-nav-tooltip>
    {{ icon(iconName) }}
    {% if badge is number %}
      <span class="app-side-nav__rail-label">{{ text }} ({{ badge }}<span class="govuk-visually-hidden"> {{ badgeUnit }}</span>)</span>
      <span class="app-side-nav__rail-dot" aria-hidden="true">{{ badge }}</span>
    {% else %}
      <span class="app-side-nav__rail-label">{{ text }}</span>
    {% endif %}
    <span class="app-side-nav__tooltip" aria-hidden="true">{{ text }}</span>
  </a>
{% endmacro %}

{% macro railExpand(text, iconName) %}
  <button type="submit" form="side-nav-toggle-form" class="app-side-nav__rail-item" data-side-nav-tooltip>
    {{ icon(iconName) }}
    <span class="app-side-nav__rail-label">{{ text }}</span>
    <span class="app-side-nav__tooltip" aria-hidden="true">{{ text }}</span>
  </button>
{% endmacro %}

{% if sideNavCollapsed %}
<nav class="app-side-nav app-side-nav--rail" aria-label="Guidance hub">
  <ul class="app-side-nav__rail-list">
    <li>{{ railExpand("Expand navigation", "expand") }}</li>
  </ul>

  <ul class="app-side-nav__rail-list">
    {% for item in listItems %}
      <li>{{ railItem(item.text, item.icon, item.href, item.current, item.badge, item.badgeUnit, item.ariaCurrent) }}</li>
    {% endfor %}
  </ul>

  {# An editor's work in a list of its own: the strip draws a line above it. #}
  {% if isEditor %}
    <ul class="app-side-nav__rail-list" aria-label="Maintenance">
      {% for item in editorItems %}
        <li>{{ railItem(item.text, item.icon, item.href, item.current) }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  <ul class="app-side-nav__rail-list app-side-nav__rail-footer">
    <li>{{ railItem("Sign out", "sign-out", "/logout") }}</li>
  </ul>
</nav>
{% else %}
<nav class="app-side-nav" aria-label="Guidance hub">
  <div class="app-side-nav__header">
    <div class="app-side-nav__identity">
      <img
        src="{{ getAssetPath('src/client/images/defra-logo.svg') }}"
        alt="Department for Environment, Food &amp; Rural Affairs"
        class="app-side-nav__logo"
      />
      <p class="app-side-nav__service">
        <a href="/hub" class="app-side-nav__service-link">{{ serviceName }}</a>
      </p>
    </div>
    <button type="submit" form="side-nav-toggle-form" class="app-side-nav__icon-button">
      {{ icon("collapse") }}
      <span class="govuk-visually-hidden">Collapse navigation</span>
    </button>
  </div>

  {% if not hideNavSearch %}
  <form class="app-side-nav__search" method="get" action="/hub" role="search">
    <label class="govuk-visually-hidden" for="side-nav-search">Search or ask question</label>
    <span class="app-side-nav__search-icon">{{ icon("search") }}</span>
    <input class="app-side-nav__search-input" id="side-nav-search" name="search" type="search" autocomplete="off" placeholder="Search or ask question">
    <button type="submit" class="govuk-visually-hidden-focusable">Search</button>
  </form>
  {% endif %}

  <ul class="app-side-nav__list">
    {% for item in listItems %}
      <li>
        <a class="app-side-nav__link{% if item.current %} app-side-nav__link--current{% endif %}" href="{{ item.href }}"{% if item.current %} aria-current="{{ item.ariaCurrent or 'page' }}"{% endif %}>
          {{ icon(item.icon) }}
          <span class="app-side-nav__text">{{ item.text }}</span>
          {# A count the hub has for the list, as the prototype shows one. #}
          {% if item.badge is number %}
            <span class="app-side-nav__badge">{{ item.badge }}<span class="govuk-visually-hidden"> {{ item.badgeUnit }}</span></span>
          {% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>

  {% if isEditor %}
    <h2 class="app-side-nav__label" id="side-nav-maintenance">Maintenance</h2>
    <ul class="app-side-nav__list" aria-labelledby="side-nav-maintenance">
      {% for item in editorItems %}
        <li>
          <a class="app-side-nav__link{% if item.current %} app-side-nav__link--current{% endif %}" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>
            {{ icon(item.icon) }}
            <span class="app-side-nav__text">{{ item.text }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {#
    The user's pins, guides and sections of guides, in their order (pins,
    from server/side-nav-lists.js). Each has a "…" menu of forms, so they
    open, unpin and move without JavaScript; each form sends where the page
    showed the pin, and a move every pin in the order shown, by its key, so a
    page whose pins have changed since changes nothing. With JavaScript they
    can be dragged into a new order (side-nav-reorder.js), which keeps these
    positions up to date.
  #}
  {% set pins = pins or [] %}
  <details class="app-side-nav__section" id="side-nav-pinned" open>
    <summary class="app-side-nav__section-summary">
      <span class="app-side-nav__label">Pinned guidance</span>
      <span class="app-side-nav__section-count">{{ pins.length }}<span class="govuk-visually-hidden"> pinned</span></span>
      {{ icon("chevron-down", "app-side-nav__chevron") }}
    </summary>
    {% if pins.length %}
      <ul class="app-side-nav__list" data-reorder-list="/pin-order" data-reorder-elsewhere="/pin-toggle">
        {% for pin in pins %}
          {# What a screen reader calls it: a section's heading may be another
             guide's too, so a section is named with its guide. #}
          {% set pinName = pin.label + (", in " + pin.guideTitle if pin.guideTitle else "") %}
          <li class="app-side-nav__row" data-reorder-id="{{ pin.key }}" data-reorder-label="{{ pinName }}">
            <a class="app-side-nav__link" href="{{ pin.href }}" draggable="false" data-reorder-handle>
              {{ icon("star-filled", "app-side-nav__star") }}
              {# A section's guide on a line of its own, wrapping with the heading. #}
              <span class="app-side-nav__text">{{ pin.label }}{% if pin.guideTitle %}<span class="govuk-visually-hidden">, in </span><span class="app-side-nav__in-guide">{{ pin.guideTitle }}</span>{% endif %}</span>
            </a>
            <details class="app-side-nav__more">
              <summary class="app-side-nav__icon-button app-side-nav__more-button">
                {{ icon("more") }}
                <span class="govuk-visually-hidden">More actions for {{ pinName }}</span>
              </summary>
              <div class="app-side-nav__popover">
                <a class="app-side-nav__menu-item" href="{{ pin.href }}">Open</a>
                <form method="post" action="/pin-toggle" data-reorder-follows="{{ pin.key }}">
                  <input type="hidden" name="guideId" value="{{ pin.id }}">
                  <input type="hidden" name="pin" value="false">
                  <input type="hidden" name="position" value="{{ pin.position }}">
                  {% if pin.sectionId %}<input type="hidden" name="sectionId" value="{{ pin.sectionId }}">{% endif %}
                  <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                  <button type="submit" class="app-side-nav__menu-item">Unpin<span class="govuk-visually-hidden"> {{ pinName }}</span></button>
                </form>
                {#
                  Move up and Move down are the way to reorder without
                  dragging, or without JavaScript. Both are always there,
                  hidden with no neighbour, so a drag can bring them up to date.
                #}
                {% for move in [{ text: "Move up", step: -1, hidden: pin.isFirst }, { text: "Move down", step: 1, hidden: pin.isLast }] %}
                  <form method="post" action="/pin-order" data-reorder-move="{{ move.step }}"{% if move.hidden %} hidden{% endif %}>
                    {% for shown in pins %}<input type="hidden" name="order" value="{{ shown.key }}">{% endfor %}
                    <input type="hidden" name="from" value="{{ pin.position }}">
                    <input type="hidden" name="to" value="{{ pin.position + move.step }}">
                    <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                    <button type="submit" class="app-side-nav__menu-item">{{ move.text }}<span class="govuk-visually-hidden"> {{ pinName }}</span></button>
                  </form>
                {% endfor %}
              </div>
            </details>
          </li>
        {% endfor %}
      </ul>
      <p class="govuk-visually-hidden" role="status" data-reorder-status></p>
    {% else %}
      <p class="app-side-nav__empty">{{ sideNavMessages.nonePinned }}</p>
    {% endif %}
  </details>

  <details class="app-side-nav__section" id="side-nav-bookmarks" open>
    <summary class="app-side-nav__section-summary">
      <span class="app-side-nav__label">Case bookmarks</span>
      <span class="app-side-nav__section-count">{{ caseBookmarks.cases.length }}<span class="govuk-visually-hidden"> cases</span></span>
      {{ icon("chevron-down", "app-side-nav__chevron") }}
    </summary>
    {% if caseBookmarks.cases.length %}
      <ul class="app-side-nav__list" data-reorder-list="/case-bookmarks/order">
        {% for case in caseBookmarks.cases %}
          <li class="app-side-nav__case" data-reorder-id="{{ case.key }}" data-reorder-label="{{ case.name }}">
            <div class="app-side-nav__row">
              {% set caseIsCurrent = case.key == currentCaseKey %}
              <a class="app-side-nav__link{% if caseIsCurrent %} app-side-nav__link--current{% endif %}" href="{{ case.href }}"{% if caseIsCurrent %} aria-current="page"{% endif %} draggable="false" data-reorder-handle>
                {{ icon("bookmark") }}
                <span class="app-side-nav__text">
                  <span class="app-side-nav__ref-type">{{ case.typeLabel }}</span>
                  <span class="govuk-visually-hidden">: </span>{{ case.ref }}</span>
                <span class="app-side-nav__meta">{{ case.guides.length }} guide{{ "s" if case.guides.length != 1 }}</span>
              </a>
              <details class="app-side-nav__more">
                <summary class="app-side-nav__icon-button app-side-nav__more-button">
                  {{ icon("more") }}
                  <span class="govuk-visually-hidden">More actions for {{ case.name }}</span>
                </summary>
                <div class="app-side-nav__popover">
                  <form method="post" action="/case-bookmarks/remove">
                    <input type="hidden" name="key" value="{{ case.key }}">
                    <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                    <button type="submit" class="app-side-nav__menu-item">Remove bookmark<span class="govuk-visually-hidden"> {{ case.name }}</span></button>
                  </form>
                  {% for move in [{ text: "Move up", step: -1, hidden: case.isFirst }, { text: "Move down", step: 1, hidden: case.isLast }] %}
                    <form method="post" action="/case-bookmarks/order" data-reorder-move="{{ move.step }}"{% if move.hidden %} hidden{% endif %}>
                      {% for shown in caseBookmarks.order %}<input type="hidden" name="order" value="{{ shown }}">{% endfor %}
                      <input type="hidden" name="from" value="{{ case.position }}">
                      <input type="hidden" name="to" value="{{ case.position + move.step }}">
                      <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                      <button type="submit" class="app-side-nav__menu-item">{{ move.text }}<span class="govuk-visually-hidden"> {{ case.name }}</span></button>
                    </form>
                  {% endfor %}
                </div>
              </details>
            </div>
            {% if case.guides.length %}
              <ul class="app-side-nav__sublist" aria-label="Guides bookmarked to {{ case.name }}" data-reorder-list="/case-bookmarks/guide-order" data-reorder-fields="{{ { key: case.key } | dump }}">
                {% for guide in case.guides %}
                  <li data-reorder-id="{{ guide.id }}" data-reorder-label="{{ guide.title }}">
                    <div class="app-side-nav__row">
                      <a class="app-side-nav__sublink" href="{{ guide.href }}" draggable="false" data-reorder-handle>{{ guide.title }}</a>
                      <details class="app-side-nav__more">
                        <summary class="app-side-nav__icon-button app-side-nav__more-button">
                          {{ icon("more") }}
                          <span class="govuk-visually-hidden">More actions for {{ guide.title }}</span>
                        </summary>
                        <div class="app-side-nav__popover">
                          <form method="post" action="/case-bookmarks/remove">
                            <input type="hidden" name="key" value="{{ case.key }}">
                            <input type="hidden" name="guideId" value="{{ guide.id }}">
                            <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                            <button type="submit" class="app-side-nav__menu-item">Remove<span class="govuk-visually-hidden"> {{ guide.title }} from {{ case.name }}</span></button>
                          </form>
                          {% for move in [{ text: "Move up", step: -1, hidden: guide.isFirst }, { text: "Move down", step: 1, hidden: guide.isLast }] %}
                            <form method="post" action="/case-bookmarks/guide-order" data-reorder-move="{{ move.step }}"{% if move.hidden %} hidden{% endif %}>
                              <input type="hidden" name="key" value="{{ case.key }}">
                              {% for shown in case.guideOrder %}<input type="hidden" name="order" value="{{ shown }}">{% endfor %}
                              <input type="hidden" name="from" value="{{ guide.position }}">
                              <input type="hidden" name="to" value="{{ guide.position + move.step }}">
                              <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                              <button type="submit" class="app-side-nav__menu-item">{{ move.text }}<span class="govuk-visually-hidden"> {{ guide.title }}</span></button>
                            </form>
                          {% endfor %}
                        </div>
                      </details>
                    </div>
                    {# Sections come in the guide's own order, so they are only
                       ever removed, never moved. #}
                    <ul class="app-side-nav__section-list" aria-label="Bookmarked sections of {{ guide.title }}">
                      {% for section in guide.sections %}
                        {# Named with its guide, as two guides may share a heading. #}
                        {% set sectionName = section.label + ", in " + guide.title %}
                        <li class="app-side-nav__row">
                          <a class="app-side-nav__sublink app-side-nav__section-link" href="{{ section.href }}">{{ section.label }}</a>
                          <details class="app-side-nav__more">
                            <summary class="app-side-nav__icon-button app-side-nav__more-button">
                              {{ icon("more") }}
                              <span class="govuk-visually-hidden">More actions for {{ sectionName }}</span>
                            </summary>
                            <div class="app-side-nav__popover">
                              <form method="post" action="/case-bookmarks/remove">
                                <input type="hidden" name="key" value="{{ case.key }}">
                                <input type="hidden" name="guideId" value="{{ guide.id }}">
                                <input type="hidden" name="sectionId" value="{{ section.sectionId }}">
                                <input type="hidden" name="returnTo" value="{{ currentUrl }}">
                                <button type="submit" class="app-side-nav__menu-item">Remove<span class="govuk-visually-hidden"> {{ sectionName }}, from {{ case.name }}</span></button>
                              </form>
                            </div>
                          </details>
                        </li>
                      {% endfor %}
                    </ul>
                  </li>
                {% endfor %}
              </ul>
              <p class="govuk-visually-hidden" role="status" data-reorder-status></p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      <p class="govuk-visually-hidden" role="status" data-reorder-status></p>
    {% else %}
      <p class="app-side-nav__empty">{{ sideNavMessages.noCaseBookmarks }}</p>
    {% endif %}
  </details>

  <ul class="app-side-nav__list app-side-nav__footer">
    {% if userDisplayName %}
      <li class="app-side-nav__user">
        <div class="app-side-nav__user-name">{{ userDisplayName }}</div>
        {% if userRolesCaption %}
          <div class="app-side-nav__user-roles">{{ userRolesCaption }}</div>
        {% endif %}
      </li>
    {% endif %}
    <li><a class="app-side-nav__link" href="/logout">Sign out</a></li>
  </ul>
</nav>
{% endif %}
