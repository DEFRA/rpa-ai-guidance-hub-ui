# Without a session cookie password the app will fail to start. You can generate a password using the following command:
# openssl rand -base64 32
SESSION_COOKIE_PASSWORD=

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_AUTH=secret
ENTRA_CLIENT_SECRET=

ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
ENTRA_REDIRECT_HOST=http://localhost:3000
GUIDANCE_API_BASE_URL=http://localhost:3001
GUIDANCE_API_TIMEOUT=10000

# Enforce roles: Hub.Viewer to use the service, Hub.Editor for editor pages (default false)
AUTH_ENFORCE_ROLES=false
DEV_USER_ROLES=Hub.Editor,Hub.Viewer

# Bookmarks to SBIs as well as case IDs (default false). Turn it on in the guidance API too,
# which otherwise refuses them.
FEATURE_SBI_BOOKMARKS=false
