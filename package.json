{
  "name": "rpa-ai-guidance-hub-ui",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "git:pre-commit-hook": "npm run lint",
    "git:setup-hooks": "husky",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --use-strict ./src/index.js",
    "start:dev": "NODE_ENV=development run-p build:watch server:watch",
    "start:debug": "NODE_ENV=development run-p build:watch server:debug",
    "dev": "npm run start:dev",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --env-file-if-exists=.env --watch src --watch .public --ext js,njk,yaml,json --ignore src/client --exec 'node --env-file-if-exists=.env --use-strict ./src/index.js'",
    "server:watch": "nodemon --env-file-if-exists=.env --watch src --watch .public --ext js,njk,yaml,json --ignore src/client --exec 'node --env-file-if-exists=.env --use-strict ./src/index.js'",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "TZ=UTC run-s lint build test:js",
    "test:js": "TZ=UTC vitest run --coverage"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sts": "3.1152.0",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "date-fns": "4.4.0",
    "flatted": "3.4.4",
    "govuk-frontend": "6.5.1",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "jwks-rsa": "4.1.0",
    "lodash": "4.18.1",
    "marked": "18.0.14",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "semver": "7.8.5",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-blockquote": "3.31.4",
